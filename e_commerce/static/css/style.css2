/* ============================================
   LUXE — Premium E-Commerce Template
   Main Stylesheet
   ============================================ */

/* ---------- 1. Design Tokens ---------- */
:root {
  /* Colors */
  --color-primary: #d46013;
  --color-primary-dark: #e65f00;
  --color-primary-light: #ff8a33;
  --color-primary-soft: #fff1e6;

  --color-white: #ffffff;
  --color-charcoal: #1f2937;
  --color-charcoal-light: #374151;
  --color-bg: #f8f9fa;
  --color-surface: #ffffff;
  /* Fixed dark "ink" surface for elements meant to stay dark in
     BOTH light and dark mode (footer, flash-sale panel, page-banner,
     topbar, dark buttons). Intentionally NOT overridden below. */
  --color-ink: #1f2937;
  --color-ink-text: #e5e7eb;
  --color-ink-text-muted: #d1d5db;

  --color-text: #1f2937;
  --color-muted: #6b7280;
  --color-border: #e5e7eb;

  --color-success: #16a34a;
  --color-danger: #dc2626;
  --color-star: #f59e0b;

  /* Typography */
  --font-heading: 'Poppins', 'Segoe UI', sans-serif;
  --font-body: 'Inter', 'Segoe UI', sans-serif;

  /* Spacing scale */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.5rem;
  --space-6: 2rem;
  --space-7: 3rem;
  --space-8: 4rem;
  --space-9: 6rem;

  /* Radius */
  --radius-sm: 6px;
  --radius: 12px;
  --radius-lg: 20px;
  --radius-full: 999px;

  /* Shadows */
  --shadow-sm: 0 1px 2px rgba(31, 41, 55, 0.06);
  --shadow: 0 4px 16px rgba(31, 41, 55, 0.08);
  --shadow-md: 0 8px 28px rgba(31, 41, 55, 0.12);
  --shadow-lg: 0 16px 48px rgba(31, 41, 55, 0.16);

  /* Layout */
  --container: 1240px;
  --header-h: 132px;

  /* Transitions */
  --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);

  /* Theme-transition (colors only, so layout never jumps) */
  --theme-transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
}

/* ---------- 1b. Dark Theme Tokens ----------
   Applied via [data-theme="dark"] on <html>. Falls back to the light
   tokens above automatically for anything not overridden here. */
html[data-theme="dark"] {
  --color-primary: #ff8a3d;
  --color-primary-dark: #ff9f5c;
  --color-primary-light: #ffb27a;
  --color-primary-soft: #3a2414;

  --color-white: #ffffff;
  --color-charcoal: #f3f4f6;
  --color-charcoal-light: #d1d5db;
  --color-bg: #101317;
  --color-surface: #191d23;

  --color-text: #e5e7eb;
  --color-muted: #9aa2af;
  --color-border: #2b303a;

  --color-success: #34d366;
  --color-danger: #f0554a;
  --color-star: #ffc24b;

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.35);
  --shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  --shadow-md: 0 8px 28px rgba(0, 0, 0, 0.45);
  --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.55);

  color-scheme: dark;
}

html {
  color-scheme: light;
}

/* Respect the system preference the very first time, before any manual
   choice has been saved (the inline head script sets data-theme as soon
   as it can; this is a CSS-only fallback/belt-and-braces). */
@media (prefers-color-scheme: dark) {
  html:not([data-theme="light"]):not([data-theme="dark"]) {
    color-scheme: dark;
  }
}

/* Every themeable surface transitions smoothly when the mode is switched */
body,
.header,
.nav,
.product-card,
.card,
.auth-card,
footer,
input,
textarea,
select,
.btn {
  transition: var(--theme-transition);
}

/* ---------- 2. Reset ---------- */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font-body);
  background-color: var(--color-bg);
  color: var(--color-text);
  line-height: 1.6;
  font-size: 16px;
  overflow-x: hidden;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--font-heading);
  font-weight: 700;
  line-height: 1.2;
  color: var(--color-charcoal);
}

img {
  max-width: 100%;
  display: block;
}

/* ---------- Responsive: very small screens (340px and below) ---------- */
@media (max-width: 340px) {
  :root {
    --space-1: 0.2rem;
    --space-2: 0.4rem;
    --space-3: 0.6rem;
    --space-4: 0.6rem;
    --space-5: 1rem;
    --space-6: 1.2rem;
  }

  html,
  body {
    font-size: 14px;
  }

  .container {
    padding-inline: 0.5rem;
  }

  .topbar {
    display: none;
  }

  .header-main {
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    padding-block: 0.6rem;
  }

  .logo {
    font-size: 1.15rem;
  }

  .search-bar {
    max-width: 100%;
    padding: 0.15rem 0.6rem 0.15rem 0.8rem;
  }

  .search-bar input {
    padding: 0.45rem 0.5rem;
    font-size: 0.95rem;
  }

  .header-main .icon-btn.menu-toggle {
    width: 40px;
    height: 40px;
  }

  .section {
    padding-block: 1.2rem;
  }

  .section-head h2 {
    font-size: 1.2rem;
  }

  .grid {
    gap: 0.6rem;
  }

  /* Product cards: stacked, compact */
  .product-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    padding: 0.6rem;
    border-radius: 10px;
  }

  .product-media {
    position: relative;
  }

  .product-media img {
    border-radius: 8px;
    height: 140px;
    object-fit: cover;
  }

  .product-body {
    padding: 0.2rem 0;
  }

  .product-title {
    font-size: 0.85rem;
  }

  .price-now {
    font-size: 0.9rem;
  }

  .price-old {
    font-size: 0.72rem;
  }

  .product-actions {
    right: 8px;
    top: 8px;
  }

  .btn {
    padding: 0.6rem 0.9rem;
    font-size: 0.9rem;
  }

  .btn svg {
    width: 16px;
    height: 16px;
  }

  /* Footer and other dense elements */
  .section-head p {
    font-size: 0.85rem;
  }

  /* Keep modals and overlays full-width friendly */
  .shop-sidebar {
    width: 100%;
    box-shadow: none;
  }
}

/* ---------- Responsive: small and medium screens ---------- */
@media (max-width: 480px) {
  :root {
    --space-4: 0.75rem;
    --space-5: 1rem;
  }

  body {
    font-size: 15px;
  }

  /* Header: compact with a collapsed search */
  .header-main {
    padding-block: 0.6rem;
    gap: 0.5rem;
  }

  .logo {
    font-size: 1.2rem;
  }

  .search-bar {
    max-width: none;
  }

  /* Product grid: 2 columns on small phones, 1 on smallest */
  .product-grid,
  .grid.products,
  .shop-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .product-card {
    padding: 0.6rem;
    border-radius: 10px;
  }

  .product-media img {
    height: 160px;
  }

  /* Buttons full width where appropriate */
  .btn-block,
  .product-card .btn {
    width: 100%;
  }

  /* Compact price and title */
  .product-title {
    font-size: 0.92rem;
  }

  .price-now {
    font-size: 0.98rem;
  }

  .price-old {
    font-size: 0.8rem;
  }

  /* Filters and sidebar become overlay style */
  .shop-sidebar {
    width: 100%;
    position: relative;
    box-shadow: none;
  }

  /* Footer spacing */
  footer .container {
    padding-inline: 0.6rem;
  }
}

@media (max-width: 768px) {
  :root {
    --container: 720px;
  }

  body {
    font-size: 15px;
  }

  .section {
    padding-block: var(--space-7);
  }

  /* Header layout for tablets */
  .header-main {
    flex-wrap: wrap;
    padding-block: 1rem;
  }

  .search-bar {
    max-width: 100%;
  }

  /* Product listing: 3 columns on larger tablets, 2 on small tablets */
  .product-grid,
  .grid.products,
  .shop-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .product-media img {
    height: 200px;
  }

  .btn {
    padding: 0.7rem 1rem;
  }
}

a {
  text-decoration: none;
  color: inherit;
  transition: color var(--transition);
}

ul {
  list-style: none;
}

button,
input,
select,
textarea {
  font-family: inherit;
  font-size: inherit;
}

button {
  cursor: pointer;
  border: none;
  background: none;
}

/* ---------- 3. Utilities ---------- */
.container {
  width: 100%;
  max-width: var(--container);
  margin-inline: auto;
  padding-inline: var(--space-4);
}

.section {
  padding-block: var(--space-9);
}

.section-sm {
  padding-block: var(--space-7);
}

.section-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--space-2);
  margin-bottom: var(--space-7);
}

.section-head.left {
  align-items: flex-start;
  text-align: left;
}

.section-head .eyebrow {
  color: var(--color-primary);
  font-weight: 600;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.section-head h2 {
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  text-wrap: balance;
}

.section-head p {
  color: var(--color-muted);
  max-width: 540px;
}

.text-primary {
  color: var(--color-primary);
}

.text-muted {
  color: var(--color-muted);
}

.grid {
  display: grid;
  gap: var(--space-5);
}

.flex {
  display: flex;
}

.items-center {
  align-items: center;
}

.justify-between {
  justify-content: space-between;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: 0.8rem 1.6rem;
  border-radius: var(--radius-full);
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.95rem;
  transition: all var(--transition);
  white-space: nowrap;
  line-height: 1;
}

.btn svg {
  width: 18px;
  height: 18px;
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-white);
  box-shadow: 0 6px 18px rgba(255, 107, 0, 0.32);
}

.btn-primary:hover {
  background: var(--color-primary-dark);
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(255, 107, 0, 0.4);
}

.btn-dark {
  background: var(--color-ink);
  color: var(--color-white);
}

.btn-dark:hover {
  background: var(--color-charcoal-light);
  transform: translateY(-2px);
}

.btn-outline {
  background: transparent;
  color: var(--color-charcoal);
  border: 1.5px solid var(--color-border);
}

.btn-outline:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.btn-ghost {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.btn-ghost:hover {
  background: var(--color-primary);
  color: var(--color-white);
}

.btn-block {
  width: 100%;
}

.btn-lg {
  padding: 1rem 2rem;
  font-size: 1.05rem;
}

.btn-sm {
  padding: 0.55rem 1rem;
  font-size: 0.85rem;
}

/* Badges */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 0.25rem 0.65rem;
  border-radius: var(--radius-full);
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.badge-sale {
  background: var(--color-danger);
  color: #fff;
}

.badge-new {
  background: var(--color-success);
  color: #fff;
}

.badge-hot {
  background: var(--color-primary);
  color: #fff;
}

/* ---------- 4. Header ---------- */
.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--color-white);
  box-shadow: var(--shadow-sm);
}

.topbar {
  background: var(--color-ink);
  color: var(--color-ink-text-muted);
  font-size: 0.82rem;
}

.topbar .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-block: 0.5rem;
}

.topbar a {
  color: #d1d5db;
}

.topbar a:hover {
  color: var(--color-primary-light);
}

.topbar-links {
  display: flex;
  gap: var(--space-4);
}

.header-main {
  display: flex;
  align-items: center;
  gap: var(--space-5);
  padding-block: var(--space-4);
}

.logo {
  font-family: var(--font-heading);
  font-weight: 800;
  font-size: 1.6rem;
  color: var(--color-charcoal);
  letter-spacing: -0.02em;
  flex-shrink: 0;
}

.logo span {
  color: var(--color-primary);
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-full);
  padding: 0.2rem 0.2rem 0.2rem 1.2rem;
  max-width: 560px;
  transition: border-color var(--transition);
}

.search-bar:focus-within {
  border-color: var(--color-primary);
}

.search-bar input {
  flex: 1;
  border: none;
  background: transparent;
  outline: none;
  padding: 0.6rem 0.5rem;
  color: var(--color-text);
}

.search-bar button {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-full);
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  transition: background var(--transition);
}

.search-bar button:hover {
  background: var(--color-primary-dark);
}

.search-bar svg {
  width: 20px;
  height: 20px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-shrink: 0;
}

.icon-btn {
  position: relative;
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: var(--radius-full);
  color: var(--color-charcoal);
  transition: background var(--transition), color var(--transition);
}

.icon-btn:hover {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.icon-btn svg {
  width: 24px;
  height: 24px;
}

.icon-btn .count {
  position: absolute;
  top: 4px;
  right: 2px;
  background: var(--color-primary);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  min-width: 18px;
  height: 18px;
  padding: 0 4px;
  border-radius: var(--radius-full);
  display: grid;
  place-items: center;
}

/* Nav */
.nav {
  border-top: 1px solid var(--color-border);
  background: var(--color-white);
}

.nav .container {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.nav-list {
  display: flex;
  align-items: center;
  gap: var(--space-1);
}

.nav-list>li>a,
.nav-cats {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0.9rem var(--space-4);
  font-weight: 500;
  font-size: 0.95rem;
  color: var(--color-charcoal);
  position: relative;
}

.nav-list>li>a:hover,
.nav-cats:hover {
  color: var(--color-primary);
}

.nav-list>li>a.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: var(--space-4);
  right: var(--space-4);
  height: 3px;
  background: var(--color-primary);
  border-radius: 3px 3px 0 0;
}

/* Categories dropdown */
.nav-dropdown {
  position: relative;
}

.nav-cats {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
}

.nav-cats:hover {
  color: #fff;
  background: var(--color-primary-dark);
}

.dropdown-menu {
  position: absolute;
  top: 100%;
  left: 0;
  min-width: 240px;
  background: var(--color-surface);
  box-shadow: var(--shadow-md);
  border-radius: 0 0 var(--radius) var(--radius);
  padding: var(--space-2);
  opacity: 0;
  visibility: hidden;
  transform: translateY(8px);
  transition: all var(--transition);
  z-index: 50;
}

.nav-dropdown:hover .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.dropdown-menu a {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 0.7rem var(--space-3);
  border-radius: var(--radius-sm);
  color: var(--color-charcoal);
  font-size: 0.92rem;
}

.dropdown-menu a:hover {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.menu-toggle {
  display: none;
}

/* ---------- 5. Footer ---------- */
.footer {
  background: var(--color-ink);
  color: var(--color-ink-text-muted);
  padding-top: var(--space-9);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.6fr repeat(3, 1fr);
  gap: var(--space-6);
  padding-bottom: var(--space-7);
}

.footer h4 {
  color: #fff;
  font-size: 1.05rem;
  margin-bottom: var(--space-4);
}

.footer .logo {
  color: #fff;
}

.footer p {
  color: #9ca3af;
  margin-bottom: var(--space-4);
  font-size: 0.92rem;
}

.footer-links li {
  margin-bottom: var(--space-3);
}

.footer-links a {
  color: #9ca3af;
  font-size: 0.92rem;
}

.footer-links a:hover {
  color: var(--color-primary-light);
  padding-left: 4px;
}

.footer-newsletter {
  display: flex;
  background: #374151;
  border-radius: var(--radius-full);
  overflow: hidden;
  padding: 4px;
  margin-bottom: var(--space-5);
}

.footer-newsletter input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: #fff;
  padding: 0.6rem 1rem;
}

.footer-newsletter input::placeholder {
  color: #9ca3af;
}

.footer-newsletter button {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-full);
  padding: 0 1.2rem;
  font-weight: 600;
}

.footer-newsletter button:hover {
  background: var(--color-primary-dark);
}

.socials {
  display: flex;
  gap: var(--space-3);
}

.socials a {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: var(--radius-full);
  background: #374151;
  color: #d1d5db;
}

.socials a:hover {
  background: var(--color-primary);
  color: #fff;
  transform: translateY(-3px);
}

.socials svg {
  width: 20px;
  height: 20px;
}

.footer-bottom {
  border-top: 1px solid #374151;
  padding-block: var(--space-4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-3);
  font-size: 0.88rem;
}

.payment-icons {
  display: flex;
  gap: var(--space-2);
  align-items: center;
}

.payment-icons span {
  background: var(--color-surface);
  color: var(--color-charcoal);
  font-weight: 700;
  font-size: 0.7rem;
  padding: 4px 8px;
  border-radius: 4px;
}

/* ---------- 6. Product Card ---------- */
.product-card {
  background: var(--color-surface);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition), box-shadow var(--transition);
  position: relative;
  display: flex;
  flex-direction: column;
}

.product-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-md);
}

.product-media {
  position: relative;
  aspect-ratio: 1;
  background: var(--color-surface);
  overflow: hidden;
}

.product-media img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: var(--space-4);
  transition: transform var(--transition);
}

.product-card>img {
  width: 100%;
  display: block;
  object-fit: cover;
  aspect-ratio: 4 / 3;
}

.product-card:hover .product-media img {
  transform: scale(1.06);
}

.product-badges {
  position: absolute;
  top: var(--space-3);
  left: var(--space-3);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  z-index: 2;
}

.product-actions {
  position: absolute;
  top: var(--space-3);
  right: var(--space-3);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  z-index: 2;
  opacity: 0;
  transform: translateX(12px);
  transition: all var(--transition);
}

.product-card:hover .product-actions {
  opacity: 1;
  transform: translateX(0);
}

.product-actions button {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  box-shadow: var(--shadow);
  display: grid;
  place-items: center;
  color: var(--color-charcoal);
  transition: all var(--transition);
}

.product-actions button:hover {
  background: var(--color-primary);
  color: #fff;
}

.product-actions button.active {
  background: var(--color-primary);
  color: #fff;
}

.product-actions svg {
  width: 18px;
  height: 18px;
}

.product-body {
  padding: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  flex: 1;
}

.product-cat {
  font-size: 0.78rem;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.product-title {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 1rem;
  color: var(--color-charcoal);
  line-height: 1.4;
}

.product-title a:hover {
  color: var(--color-primary);
}

.stars {
  display: flex;
  align-items: center;
  gap: 2px;
  color: var(--color-star);
}

.stars svg {
  width: 15px;
  height: 15px;
}

.stars .rating-count {
  color: var(--color-muted);
  font-size: 0.8rem;
  margin-left: 4px;
}

.product-price {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: auto;
}

.price-now {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.2rem;
  color: var(--color-charcoal);
}

.price-old {
  color: var(--color-muted);
  text-decoration: line-through;
  font-size: 0.95rem;
}

.product-body .btn {
  margin-top: var(--space-3);
}

/* ---------- 7. Section Grids ---------- */
.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-5);
}

/* ---------- 8. Hero ---------- */
.hero {
  background: linear-gradient(120deg, var(--color-primary-soft) 0%, var(--color-bg) 60%);
  overflow: hidden;
}

.hero .container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: var(--space-6);
  min-height: 520px;
}

.hero-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  align-items: flex-start;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--color-surface);
  color: var(--color-primary);
  padding: 0.4rem 0.9rem;
  border-radius: var(--radius-full);
  font-weight: 600;
  font-size: 0.85rem;
  box-shadow: var(--shadow-sm);
}

.hero h1 {
  font-size: clamp(2.2rem, 5vw, 3.6rem);
  line-height: 1.08;
  text-wrap: balance;
}

.hero h1 span {
  color: var(--color-primary);
}

.hero p {
  color: var(--color-charcoal-light);
  font-size: 1.1rem;
  max-width: 480px;
}

.hero-cta {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-top: var(--space-2);
}

.hero-stats {
  display: flex;
  gap: var(--space-6);
  margin-top: var(--space-5);
}

.hero-stats .num {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.6rem;
  color: var(--color-charcoal);
}

.hero-stats .label {
  font-size: 0.85rem;
  color: var(--color-muted);
}

.hero-media {
  position: relative;
}

.hero-media img {
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.hero-float {
  position: absolute;
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-md);
  padding: var(--space-3) var(--space-4);
  display: flex;
  align-items: center;
  gap: var(--space-3);
  font-size: 0.85rem;
  font-weight: 600;
}

.hero-float.one {
  bottom: 24px;
  left: -20px;
}

.hero-float.two {
  top: 24px;
  right: -10px;
}

.hero-float .ic {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-full);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  display: grid;
  place-items: center;
}

.hero-float .ic svg {
  width: 22px;
  height: 22px;
}

/* ---------- 9. Features bar ---------- */
.features-bar {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-4);
  padding: var(--space-5);
  margin-top: calc(var(--space-7) * -1);
  position: relative;
  top: 80px;
  z-index: 5;
}

.feature {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.feature .ic {
  width: 52px;
  height: 52px;
  border-radius: var(--radius);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.feature .ic svg {
  width: 26px;
  height: 26px;
}

.feature h5 {
  font-family: var(--font-heading);
  font-size: 0.98rem;
}

.feature p {
  font-size: 0.82rem;
  color: var(--color-muted);
}

.feature+.feature {
  border-left: 1px solid var(--color-border);
  padding-left: var(--space-4);
}

/* ---------- 10. Categories ---------- */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-5);
}

.cat-card {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  aspect-ratio: 4/3;
  box-shadow: var(--shadow-sm);
}

.cat-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition);
}

.cat-card:hover img {
  transform: scale(1.08);
}

.cat-card .overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(31, 41, 55, 0.78), rgba(31, 41, 55, 0.05));
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: var(--space-4);
  color: #fff;
}

.cat-card h4 {
  color: #fff;
  font-size: 1.1rem;
}

.cat-card span {
  font-size: 0.82rem;
  color: #e5e7eb;
}

/* ---------- 11. Flash sale ---------- */
.flash {
  background: var(--color-ink);
  color: var(--color-white);
  border-radius: var(--radius-lg);
  padding: var(--space-7);
}

.flash-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.flash-head h2 {
  color: #fff;
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.flash-head h2 svg {
  color: var(--color-primary);
  width: 32px;
  height: 32px;
}

.countdown {
  display: flex;
  gap: var(--space-2);
  align-items: center;
}

.countdown .unit {
  background: var(--color-primary);
  color: #fff;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.4rem;
  width: 58px;
  height: 58px;
  border-radius: var(--radius);
  display: grid;
  place-items: center;
  line-height: 1;
}

.countdown .unit small {
  font-size: 0.6rem;
  font-weight: 500;
}

.countdown .sep {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--color-primary);
}

/* ---------- 11b. Flash sale — Mobile (premium, uncrowded) ---------- */
@media (max-width: 600px) {
  .flash {
    padding: var(--space-5) var(--space-4);
    border-radius: var(--radius);
    /* subtle warmth instead of a flat block, reads more "premium" than plain ink */
    background: linear-gradient(165deg, var(--color-ink) 0%, #14181f 100%);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .flash-head {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .flash-head h2 {
    font-size: 1.3rem;
    gap: var(--space-2);
  }

  .flash-head h2 svg {
    width: 22px;
    height: 22px;
  }

  /* Give the countdown room to breathe and center it as its own row,
     rather than fighting the title for space in a wrapped flex line. */
  .countdown {
    gap: var(--space-2);
    justify-content: center;
  }

  .countdown .unit {
    width: 46px;
    height: 46px;
    font-size: 1rem;
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }

  .countdown .unit small {
    font-size: 0.52rem;
  }

  .countdown .sep {
    font-size: 1.1rem;
  }
}

/* ---------- 12. Testimonials ---------- */
.testimonials {
  background: var(--color-surface);
}

.testi-track {
  display: flex;
  gap: var(--space-5);
  transition: transform 0.5s ease;
}

.testi-viewport {
  overflow: hidden;
}

.testi-card {
  background: var(--color-bg);
  border-radius: var(--radius);
  padding: var(--space-6);
  min-width: calc((100% - var(--space-5) * 2) / 3);
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.testi-card .quote {
  color: var(--color-charcoal-light);
  font-style: italic;
}

.testi-author {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.testi-author img {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-full);
  object-fit: cover;
}

.testi-author strong {
  display: block;
  color: var(--color-charcoal);
}

.testi-author span {
  font-size: 0.82rem;
  color: var(--color-muted);
}

.testi-nav {
  display: flex;
  justify-content: center;
  gap: var(--space-3);
  margin-top: var(--space-6);
}

.testi-nav button {
  width: 46px;
  height: 46px;
  border-radius: var(--radius-full);
  border: 1.5px solid var(--color-border);
  display: grid;
  place-items: center;
  color: var(--color-charcoal);
  transition: all var(--transition);
}

.testi-nav button:hover {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

/* ---------- 13. Brands ---------- */
.brands {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: var(--space-8);
}

.brands span {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.5rem;
  color: #9ca3af;
  opacity: 0.7;
  transition: all var(--transition);
}

.brands span:hover {
  color: var(--color-charcoal);
  opacity: 1;
}

/* ---------- 14. Newsletter band ---------- */
.newsletter-band {
  background: linear-gradient(120deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border-radius: var(--radius-lg);
  padding: var(--space-8);
  text-align: center;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
}

.newsletter-band h2 {
  color: #fff;
  font-size: clamp(1.6rem, 3vw, 2.2rem);
}

.newsletter-band p {
  max-width: 520px;
  opacity: 0.95;
}

.newsletter-form {
  display: flex;
  gap: var(--space-2);
  background: var(--color-surface);
  border-radius: var(--radius-full);
  padding: 5px;
  width: 100%;
  max-width: 480px;
  margin-top: var(--space-2);
}

.newsletter-form input {
  flex: 1;
  border: none;
  outline: none;
  padding: 0.7rem 1.2rem;
  border-radius: var(--radius-full);
  color: var(--color-text);
}

/* ---------- 15. Breadcrumb / Page header ---------- */
.page-banner,
.page-hero {
  background: var(--color-ink);
  color: var(--color-white);
  padding-block: var(--space-7);
}

.page-banner h1,
.page-hero h1 {
  color: #fff;
  font-size: clamp(1.8rem, 3vw, 2.6rem);
}

.breadcrumb {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  color: #9ca3af;
  font-size: 0.9rem;
  margin-top: var(--space-2);
}

.breadcrumb a:hover {
  color: var(--color-primary-light);
}

.breadcrumb .sep {
  color: #6b7280;
}

.feature-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: var(--radius);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  flex-shrink: 0;
}

.category-card {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  aspect-ratio: 4/3;
  box-shadow: var(--shadow-sm);
  display: block;
  transition: transform var(--transition), box-shadow var(--transition);
}

.category-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}

.category-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.category-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(17, 24, 39, 0.68), rgba(17, 24, 39, 0.1));
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: var(--space-4);
  color: #fff;
}

.category-overlay h3 {
  margin-bottom: 0.35rem;
  font-size: 1.15rem;
}

.category-overlay span {
  font-size: 0.92rem;
  color: rgba(255, 255, 255, 0.85);
}

.pd-gallery {
  display: grid;
  gap: var(--space-4);
}

.pd-main-img {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  background: var(--color-surface);
}

.pd-main-img img {
  width: 100%;
  display: block;
  object-fit: contain;
  padding: var(--space-5);
}

.pd-thumbs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-3);
}

.pd-thumb {
  border: 1.5px solid transparent;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--color-surface);
  padding: 0.25rem;
  transition: border-color var(--transition), transform var(--transition);
}

.pd-thumb.active,
.pd-thumb:hover {
  border-color: var(--color-primary);
  transform: translateY(-2px);
}

.pd-thumb img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.pd-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.pd-info h1 {
  font-size: clamp(1.9rem, 3vw, 2.6rem);
}

.pd-rating {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  color: var(--color-muted);
}

.pd-rating span {
  font-size: 0.95rem;
}

.pd-price {
  display: flex;
  align-items: flex-end;
  gap: var(--space-3);
  margin-top: var(--space-2);
}

.pd-price .price-now {
  font-family: var(--font-heading);
  font-weight: 800;
  font-size: 2.4rem;
  color: var(--color-charcoal);
}

.pd-price .price-old {
  color: var(--color-muted);
  text-decoration: line-through;
  font-size: 1rem;
}

.pd-save {
  color: var(--color-success);
  font-weight: 700;
  background: #ecfdf5;
  padding: 0.35rem 0.75rem;
  border-radius: var(--radius-full);
  font-size: 0.9rem;
}

.pd-desc {
  color: var(--color-charcoal-light);
  line-height: 1.8;
}

.pd-stock {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0.9rem 1rem;
  border-radius: var(--radius);
  background: var(--color-primary-soft);
  color: var(--color-charcoal);
  font-weight: 600;
}

.pd-stock.low {
  background: #fee2e2;
  color: var(--color-danger);
}

html[data-theme="dark"] .pd-stock.low {
  background: rgba(240, 85, 74, 0.16);
}

.pd-buy {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.qty-stepper {
  display: inline-flex;
  align-items: center;
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-full);
  overflow: hidden;
  background: var(--color-surface);
}

.qty-stepper button {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  color: var(--color-charcoal);
  background: transparent;
  transition: background var(--transition);
}

.qty-stepper button:hover {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.qty-stepper input {
  width: 60px;
  text-align: center;
  border: none;
  outline: none;
  font-weight: 700;
}

.pd-wish {
  width: 46px;
  height: 46px;
  border-radius: var(--radius-full);
  background: var(--color-surface);
  box-shadow: var(--shadow-sm);
  display: grid;
  place-items: center;
  color: var(--color-charcoal);
}

.pd-wish.active {
  background: var(--color-primary);
  color: #fff;
}

.pd-features {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-3);
}

.pd-feature {
  display: flex;
  gap: var(--space-3);
  align-items: flex-start;
  padding: var(--space-4);
  border-radius: var(--radius);
  background: var(--color-bg);
}

.pd-feature span {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: var(--radius-sm);
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.pd-feature strong {
  display: block;
  margin-bottom: 0.35rem;
}

.pd-feature small {
  color: var(--color-muted);
}

.pd-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  font-size: 0.95rem;
  color: var(--color-muted);
}

.pd-meta a {
  color: var(--color-primary);
}

.checkout-summary {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: var(--space-6);
  position: sticky;
  top: 150px;
}

.checkout-summary h2 {
  margin-bottom: var(--space-5);
}

.checkout-items {
  display: grid;
  gap: var(--space-4);
  margin-bottom: var(--space-5);
}

.checkout-item {
  display: grid;
  grid-template-columns: 80px 1fr auto;
  gap: var(--space-3);
  align-items: center;
}

.checkout-item-img {
  position: relative;
  width: 80px;
  height: 80px;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--color-bg);
}

.checkout-item-img img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.checkout-qty {
  position: absolute;
  bottom: 6px;
  right: 6px;
  background: var(--color-ink);
  color: var(--color-white);
  font-size: 0.75rem;
  padding: 0.25rem 0.45rem;
  border-radius: var(--radius-full);
}

.checkout-item-name {
  color: var(--color-charcoal);
  font-weight: 600;
}

.summary-line {
  display: flex;
  justify-content: space-between;
  padding: var(--space-3) 0;
  color: var(--color-muted);
}

.summary-line.discount {
  color: var(--color-danger);
}

.summary-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--space-4);
  margin-top: var(--space-4);
  border-top: 1px solid var(--color-border);
  font-family: var(--font-heading);
  font-size: 1.2rem;
  font-weight: 700;
}

.secure-note {
  margin-top: var(--space-4);
  color: var(--color-muted);
  font-size: 0.92rem;
}

.checkout-card {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: var(--space-6);
  margin-bottom: var(--space-5);
}

.checkout-card h2 {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
  font-size: 1.25rem;
}

.checkout-card .step-num {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: #fff;
  font-size: 0.9rem;
}

.delivery-options {
  display: grid;
  gap: var(--space-3);
}

.delivery-opt {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-4);
  border-radius: var(--radius);
  border: 1.5px solid var(--color-border);
  cursor: pointer;
  transition: border-color var(--transition), background var(--transition);
}

.delivery-opt:hover {
  border-color: var(--color-primary);
}

.delivery-opt input {
  accent-color: var(--color-primary);
  width: 18px;
  height: 18px;
}

.delivery-price {
  color: var(--color-charcoal);
  font-weight: 700;
}

.pay-methods {
  display: grid;
  gap: var(--space-3);
}

.pay-method {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-4);
  border-radius: var(--radius);
  border: 1.5px solid var(--color-border);
  background: var(--color-surface);
  cursor: pointer;
  transition: all var(--transition);
}

.pay-method.active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.pay-method svg {
  width: 22px;
  height: 22px;
}

.order-success {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: var(--space-8);
  text-align: center;
}

.success-check {
  width: 96px;
  height: 96px;
  border-radius: var(--radius-full);
  background: var(--color-success);
  color: #fff;
  display: grid;
  place-items: center;
  margin: 0 auto var(--space-5);
  font-size: 2rem;
}

.order-success h1 {
  margin-bottom: var(--space-3);
}

.success-detail {
  display: grid;
  gap: var(--space-3);
  margin: var(--space-4) auto;
  max-width: 520px;
  text-align: left;
}

.success-detail div {
  display: flex;
  justify-content: space-between;
  color: var(--color-muted);
}

.success-note {
  color: var(--color-muted);
  margin-bottom: var(--space-5);
}

.success-actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  justify-content: center;
}

@media (max-width: 900px) {
  .pd-features {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 520px) {

  .pd-info,
  .checkout-card {
    padding: var(--space-4);
  }
}

/* ---------- 16. Shop layout ---------- */
.shop-layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: var(--space-6);
  align-items: start;
}

.shop-sidebar {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: var(--space-5);
  position: sticky;
  top: 150px;
}

.filter-group {
  padding-bottom: var(--space-5);
  margin-bottom: var(--space-5);
  border-bottom: 1px solid var(--color-border);
}

.filter-group:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.filter-group h4 {
  font-size: 1rem;
  margin-bottom: var(--space-4);
}

.filter-list li {
  margin-bottom: var(--space-3);
}

.filter-check {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  cursor: pointer;
  font-size: 0.92rem;
  color: var(--color-charcoal-light);
}

.filter-check input {
  width: 18px;
  height: 18px;
  accent-color: var(--color-primary);
  cursor: pointer;
}

.filter-check:hover {
  color: var(--color-primary);
}

.filter-check .cnt {
  margin-left: auto;
  color: var(--color-muted);
  font-size: 0.82rem;
}

.price-range {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.price-range input[type="range"] {
  width: 100%;
  accent-color: var(--color-primary);
}

.price-vals {
  display: flex;
  justify-content: space-between;
  font-weight: 600;
  font-size: 0.9rem;
}

.color-swatches {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.swatch {
  width: 30px;
  height: 30px;
  border-radius: var(--radius-full);
  border: 2px solid #fff;
  box-shadow: 0 0 0 1px var(--color-border);
  cursor: pointer;
  transition: transform var(--transition);
}

.swatch:hover {
  transform: scale(1.15);
}

.shop-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-3);
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: var(--space-3) var(--space-4);
  margin-bottom: var(--space-5);
}

.shop-toolbar .count {
  color: var(--color-muted);
  font-size: 0.92rem;
}

.toolbar-right {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.select {
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 0.5rem 0.8rem;
  background: var(--color-surface);
  color: var(--color-charcoal);
  cursor: pointer;
  outline: none;
}

.select:focus {
  border-color: var(--color-primary);
}

.shop-products {
  grid-template-columns: repeat(3, 1fr);
}

.filter-toggle {
  display: none;
}

/* Pagination */
.pagination {
  display: flex;
  justify-content: center;
  gap: var(--space-2);
  margin-top: var(--space-7);
}

.pagination a,
.pagination span {
  min-width: 44px;
  height: 44px;
  padding: 0 var(--space-3);
  border-radius: var(--radius-sm);
  display: grid;
  place-items: center;
  background: var(--color-surface);
  box-shadow: var(--shadow-sm);
  color: var(--color-charcoal);
  font-weight: 600;
  transition: all var(--transition);
}

.pagination a:hover {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.pagination .current {
  background: var(--color-primary);
  color: #fff;
}

/* ---------- 17. Product details ---------- */
.product-detail {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-7);
  align-items: start;
}

.gallery-main {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  aspect-ratio: 1;
  overflow: hidden;
  cursor: zoom-in;
  position: relative;
}

.gallery-main img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: var(--space-6);
  transition: transform 0.3s ease;
}

.gallery-thumbs {
  display: flex;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.gallery-thumbs button {
  width: 84px;
  height: 84px;
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  border: 2px solid transparent;
  transition: border-color var(--transition);
}

.gallery-thumbs button.active {
  border-color: var(--color-primary);
}

.gallery-thumbs img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: var(--space-2);
}

.detail-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.detail-info h1 {
  font-size: clamp(1.6rem, 3vw, 2.2rem);
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.detail-price {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.detail-price .price-now {
  font-size: 2rem;
}

.detail-desc {
  color: var(--color-charcoal-light);
}

.detail-row {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.detail-row .label {
  font-weight: 600;
  min-width: 90px;
}

.size-opts,
.color-opts {
  display: flex;
  gap: var(--space-2);
}

.size-opts button {
  min-width: 46px;
  height: 46px;
  border-radius: var(--radius-sm);
  border: 1.5px solid var(--color-border);
  font-weight: 600;
  transition: all var(--transition);
}

.size-opts button:hover,
.size-opts button.active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.qty-control {
  display: inline-flex;
  align-items: center;
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.qty-control button {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  color: var(--color-charcoal);
  font-size: 1.2rem;
  transition: background var(--transition);
}

.qty-control button:hover {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.qty-control input {
  width: 50px;
  text-align: center;
  border: none;
  outline: none;
  font-weight: 600;
}

.detail-cta {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.detail-extra {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  border-top: 1px solid var(--color-border);
  padding-top: var(--space-4);
  font-size: 0.92rem;
  color: var(--color-muted);
}

.detail-extra strong {
  color: var(--color-charcoal);
}

/* Tabs */
.tabs {
  margin-top: var(--space-8);
}

.tab-nav {
  display: flex;
  gap: var(--space-2);
  border-bottom: 2px solid var(--color-border);
  flex-wrap: wrap;
}

.tab-nav button {
  padding: var(--space-3) var(--space-5);
  font-weight: 600;
  color: var(--color-muted);
  border-bottom: 3px solid transparent;
  margin-bottom: -2px;
  transition: all var(--transition);
}

.tab-nav button.active {
  color: var(--color-primary);
  border-bottom-color: var(--color-primary);
}

.tab-panel {
  display: none;
  padding-top: var(--space-5);
}

.tab-panel.active {
  display: block;
}

.spec-table {
  width: 100%;
  border-collapse: collapse;
}

.spec-table tr {
  border-bottom: 1px solid var(--color-border);
}

.spec-table td {
  padding: var(--space-3) var(--space-2);
}

.spec-table td:first-child {
  font-weight: 600;
  width: 240px;
  color: var(--color-charcoal);
}

.spec-table td:last-child {
  color: var(--color-muted);
}

.review {
  display: flex;
  gap: var(--space-4);
  padding-block: var(--space-4);
  border-bottom: 1px solid var(--color-border);
}

.review img {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-full);
  object-fit: cover;
  flex-shrink: 0;
}

.review-body {
  flex: 1;
}

.review-body .head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.review-body strong {
  color: var(--color-charcoal);
}

.review-body .date {
  color: var(--color-muted);
  font-size: 0.85rem;
}

/* ---------- 18. Cart ---------- */
.cart-layout {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: var(--space-6);
  align-items: start;
}

.cart-items {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.cart-row {
  display: grid;
  grid-template-columns: 90px 1fr auto auto auto;
  align-items: center;
  gap: var(--space-4);
  padding: var(--space-4);
  border-bottom: 1px solid var(--color-border);
}

.cart-row:last-child {
  border-bottom: none;
}

.cart-row .thumb {
  width: 90px;
  height: 90px;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.cart-row .thumb img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: var(--space-2);
}

.cart-row .info strong {
  display: block;
  color: var(--color-charcoal);
}

.cart-row .info span {
  font-size: 0.85rem;
  color: var(--color-muted);
}

.cart-row .remove {
  color: var(--color-muted);
}

.cart-row .remove:hover {
  color: var(--color-danger);
}

.cart-row .line-price {
  font-weight: 700;
  font-family: var(--font-heading);
}

.summary {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: var(--space-5);
  position: sticky;
  top: 150px;
}

.summary h3 {
  margin-bottom: var(--space-4);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding-block: var(--space-3);
  color: var(--color-charcoal-light);
}

.summary-row.total {
  border-top: 1px solid var(--color-border);
  margin-top: var(--space-2);
  padding-top: var(--space-4);
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.2rem;
  color: var(--color-charcoal);
}

.coupon {
  display: flex;
  gap: var(--space-2);
  margin-block: var(--space-4);
}

.coupon input {
  flex: 1;
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 0.6rem 0.9rem;
  outline: none;
}

.coupon input:focus {
  border-color: var(--color-primary);
}

/* ---------- 19. Forms / Auth ---------- */
.form-field {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.form-field label {
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--color-charcoal);
}

.form-field input,
.form-field select,
.form-field textarea {
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 0.8rem 1rem;
  outline: none;
  background: var(--color-surface);
  color: var(--color-text);
  transition: border-color var(--transition);
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
  border-color: var(--color-primary);
}

.form-field .error-msg {
  color: var(--color-danger);
  font-size: 0.82rem;
  display: none;
}

.form-field.invalid input {
  border-color: var(--color-danger);
}

.form-field.invalid .error-msg {
  display: block;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
}

.auth-wrap {
  display: grid;
  place-items: center;
  padding-block: var(--space-9);
}

.auth-card {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-md);
  padding: var(--space-7);
  width: 100%;
  max-width: 440px;
}

.auth-card h1 {
  font-size: 1.8rem;
  margin-bottom: var(--space-2);
}

.auth-card .sub {
  color: var(--color-muted);
  margin-bottom: var(--space-5);
}

.auth-foot {
  text-align: center;
  margin-top: var(--space-4);
  color: var(--color-muted);
  font-size: 0.92rem;
}

.auth-foot a {
  color: var(--color-primary);
  font-weight: 600;
}

.form-aux {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-4);
  font-size: 0.9rem;
}

.form-aux a {
  color: var(--color-primary);
}

/* ---------- 20. Account dashboard ---------- */
.account-layout {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: var(--space-6);
  align-items: start;
}

.account-nav {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: var(--space-4);
  position: sticky;
  top: 150px;
}

.account-user {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding-bottom: var(--space-4);
  margin-bottom: var(--space-4);
  border-bottom: 1px solid var(--color-border);
}

.account-user img {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-full);
  object-fit: cover;
}

.account-user strong {
  display: block;
}

.account-user span {
  font-size: 0.82rem;
  color: var(--color-muted);
}

.account-nav a {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: 0.8rem var(--space-3);
  border-radius: var(--radius-sm);
  color: var(--color-charcoal-light);
  font-weight: 500;
  margin-bottom: 2px;
}

.account-nav a:hover,
.account-nav a.active {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.account-nav a svg {
  width: 20px;
  height: 20px;
}

.panel {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: var(--space-6);
}

.panel h2 {
  margin-bottom: var(--space-5);
  font-size: 1.4rem;
}

.stat-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.stat-card {
  background: var(--color-bg);
  border-radius: var(--radius);
  padding: var(--space-5);
}

.stat-card .num {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.8rem;
  color: var(--color-primary);
}

.stat-card .label {
  color: var(--color-muted);
  font-size: 0.9rem;
}

.order-table {
  width: 100%;
  border-collapse: collapse;
}

.order-table th {
  text-align: left;
  padding: var(--space-3);
  color: var(--color-muted);
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  border-bottom: 2px solid var(--color-border);
}

.order-table td {
  padding: var(--space-4) var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.status-pill {
  padding: 0.25rem 0.7rem;
  border-radius: var(--radius-full);
  font-size: 0.78rem;
  font-weight: 600;
}

.status-pill.delivered {
  background: #dcfce7;
  color: var(--color-success);
}

.status-pill.shipped {
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.status-pill.processing {
  background: #fef9c3;
  color: #a16207;
}

html[data-theme="dark"] .status-pill.processing {
  background: rgba(254, 249, 195, 0.16);
  color: #ffc24b;
}

.address-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-4);
}

.address-card {
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius);
  padding: var(--space-5);
  position: relative;
}

.address-card.default {
  border-color: var(--color-primary);
}

.address-card .tag {
  position: absolute;
  top: var(--space-3);
  right: var(--space-3);
}

/* ---------- 21. Contact / About / FAQ ---------- */
.contact-layout {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: var(--space-6);
  align-items: start;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.contact-item {
  display: flex;
  gap: var(--space-3);
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: var(--space-4);
}

.contact-item .ic {
  width: 48px;
  height: 48px;
  border-radius: var(--radius);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.contact-item h5 {
  font-family: var(--font-heading);
}

.contact-item p {
  color: var(--color-muted);
  font-size: 0.92rem;
}

.contact-form {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: var(--space-6);
}

.map-embed {
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  margin-top: var(--space-6);
}

.map-embed iframe {
  width: 100%;
  height: 360px;
  border: 0;
  display: block;
}

.about-hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-7);
  align-items: center;
}

.about-hero img {
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.mv-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-5);
}

.mv-card {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: var(--space-6);
}

.mv-card .ic {
  width: 56px;
  height: 56px;
  border-radius: var(--radius);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  display: grid;
  place-items: center;
  margin-bottom: var(--space-4);
}

.team-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-5);
}

.team-card {
  text-align: center;
}

.team-card img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: var(--radius);
  margin-bottom: var(--space-3);
}

.team-card h5 {
  font-family: var(--font-heading);
}

.team-card span {
  color: var(--color-primary);
  font-size: 0.9rem;
}

.faq-list {
  max-width: 800px;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.faq-item {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.faq-q {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4) var(--space-5);
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 1.05rem;
  text-align: left;
  color: var(--color-charcoal);
}

.faq-q svg {
  width: 22px;
  height: 22px;
  color: var(--color-primary);
  transition: transform var(--transition);
  flex-shrink: 0;
}

.faq-item.open .faq-q svg {
  transform: rotate(45deg);
}

.faq-a {
  max-height: 0;
  overflow: hidden;
  transition: max-height var(--transition);
}

.faq-a p {
  padding: 0 var(--space-5) var(--space-5);
  color: var(--color-muted);
}

/* ---------- 22. Checkout ---------- */
.checkout-layout {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: var(--space-6);
  align-items: start;
}

.checkout-section {
  background: var(--color-surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  padding: var(--space-6);
  margin-bottom: var(--space-5);
}

.checkout-section h3 {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
}

.checkout-section h3 .step-num {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: #fff;
  display: grid;
  place-items: center;
  font-size: 0.95rem;
}

.pay-methods {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.pay-method {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius);
  padding: var(--space-4);
  cursor: pointer;
  transition: border-color var(--transition);
}

.pay-method:hover,
.pay-method.active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.pay-method input {
  accent-color: var(--color-primary);
  width: 18px;
  height: 18px;
}

.mini-cart-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding-block: var(--space-3);
  border-bottom: 1px solid var(--color-border);
}

.mini-cart-row .thumb {
  width: 56px;
  height: 56px;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
}

.mini-cart-row .thumb img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 4px;
}

.mini-cart-row .info {
  flex: 1;
  font-size: 0.9rem;
}

.mini-cart-row .info strong {
  display: block;
}

/* ---------- 23. Wishlist ---------- */
.wishlist-grid {
  grid-template-columns: repeat(4, 1fr);
}

.empty-state {
  text-align: center;
  padding-block: var(--space-9);
}

.empty-state .ic {
  width: 90px;
  height: 90px;
  border-radius: var(--radius-full);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  display: grid;
  place-items: center;
  margin: 0 auto var(--space-4);
}

.empty-state .ic svg {
  width: 44px;
  height: 44px;
}

.empty-state h3 {
  margin-bottom: var(--space-2);
}

.empty-state p {
  color: var(--color-muted);
  margin-bottom: var(--space-4);
}

/* ---------- 24. Toast & Back to top ---------- */
.toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.toast {
  background: var(--color-ink);
  color: #fff;
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius);
  box-shadow: var(--shadow-md);
  display: flex;
  align-items: center;
  gap: var(--space-3);
  font-size: 0.92rem;
  transform: translateX(120%);
  transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
}

.toast.show {
  transform: translateX(0);
}

.toast svg {
  width: 20px;
  height: 20px;
  color: var(--color-primary);
}

.back-to-top {
  position: fixed;
  bottom: 24px;
  left: 24px;
  width: 50px;
  height: 50px;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: #fff;
  display: grid;
  place-items: center;
  box-shadow: var(--shadow-md);
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px);
  transition: all var(--transition);
  z-index: 90;
}

.back-to-top.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.back-to-top:hover {
  background: var(--color-primary-dark);
  transform: translateY(-4px);
}

/* ---------- 25. Mobile menu ---------- */
.mobile-drawer {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 300px;
  max-width: 85vw;
  background: var(--color-surface);
  z-index: 200;
  transform: translateX(-100%);
  transition: transform var(--transition);
  box-shadow: var(--shadow-lg);
  overflow-y: auto;
  padding: var(--space-5);
}

.mobile-drawer.open {
  transform: translateX(0);
}

.drawer-overlay {
  position: fixed;
  inset: 0;
  background: rgba(31, 41, 55, 0.5);
  z-index: 150;
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--transition);
}

.drawer-overlay.open {
  opacity: 1;
  visibility: visible;
}

.drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-5);
}

.mobile-drawer .nav-list {
  flex-direction: column;
  align-items: stretch;
  gap: 0;
}

.mobile-drawer .nav-list a {
  padding: var(--space-3) 0;
  border-bottom: 1px solid var(--color-border);
  display: block;
}

/* ---------- 26. Animations ---------- */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.reveal {
  opacity: 0;
}

.reveal.in {
  animation: fadeUp 0.6s ease forwards;
}

/* ---------- 27. Responsive ---------- */
@media (max-width: 1024px) {

  .products-grid,
  .cat-grid,
  .wishlist-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .shop-products {
    grid-template-columns: repeat(2, 1fr);
  }

  .team-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 900px) {
  .search-bar {
    display: none;
  }

  .menu-toggle {
    display: grid;
  }

  .nav {
    display: none;
  }

  .hero .container {
    grid-template-columns: 1fr;
    text-align: center;
    padding-block: var(--space-7);
  }

  .hero-content {
    align-items: center;
  }

  .hero-media {
    display: none;
  }

  .product-detail,
  .about-hero {
    grid-template-columns: 1fr;
  }

  .shop-layout,
  .cart-layout,
  .checkout-layout,
  .account-layout,
  .contact-layout {
    grid-template-columns: 1fr;
  }

  .shop-sidebar,
  .summary,
  .account-nav {
    position: static;
  }

  .shop-sidebar {
    display: none;
  }

  .shop-sidebar.open {
    display: block;
  }

  .filter-toggle {
    display: inline-flex;
  }
}

@media (min-width: 601px) and (max-width: 768px) {
  .countdown .unit {
    width: 48px;
    height: 48px;
    font-size: 1.1rem;
  }
}

@media (max-width: 768px) {
  :root {
    --header-h: 70px;
  }

  .topbar {
    display: none;
  }

  .features-bar {
    display: flex;
    flex-direction: column;
    position: relative;
    top: 20px;
  }

  .feature+.feature {
    border-left: none;
    padding-left: 0;
  }

  .testi-card {
    min-width: 100%;
  }

  .shop-products,
  .products-grid,
  .cat-grid,
  .wishlist-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .stat-cards,
  .address-grid,
  .mv-grid,
  .form-row {
    grid-template-columns: 1fr;
  }

  .cart-row {
    grid-template-columns: 70px 1fr;
    grid-template-areas: 'thumb info' 'thumb qty';
    row-gap: var(--space-2);
  }

  .section {
    padding-block: var(--space-7);
  }
}

@media (max-width: 520px) {

  .products-grid,
  .cat-grid,
  .shop-products,
  .wishlist-grid,
  .team-grid {
    grid-template-columns: 1fr 1fr;
  }

  .footer-grid {
    grid-template-columns: 1fr;
  }

  .hero {
    overflow: visible;
  }

  .hero .container {
    grid-template-columns: 1fr;
    text-align: center;
    min-height: auto;
    padding-block: var(--space-7);
  }

  .hero-content {
    align-items: center;
  }

  .hero p {
    max-width: 100%;
    margin-inline: auto;
  }

  .hero-cta {
    justify-content: center;
  }

  .hero-stats {
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
  }

  .breadcrumb {
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .newsletter-band p {
    max-width: 100%;
  }

  .features-bar {
    grid-template-columns: 1fr 1fr;
  }

  .shop-toolbar {
    align-items: stretch;
    gap: var(--space-3);
  }

  .shop-toolbar .result-count {
    width: 100%;
  }

  .sort-wrap {
    width: 100%;
  }

  .sort-wrap label {
    display: block;
    margin-bottom: var(--space-2);
  }

  .sort-wrap select {
    width: 100%;
  }

  .footer-newsletter {
    flex-direction: column;
    align-items: stretch;
  }

  .footer-newsletter button {
    width: 100%;
  }

  .header-main {
    gap: var(--space-3);
  }

  .logo {
    font-size: 1.3rem;
  }
}

@media (max-width: 420px) {

  .products-grid,
  .cat-grid,
  .shop-products,
  .wishlist-grid,
  .team-grid,
  .footer-grid {
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: clamp(1.9rem, 10vw, 2.6rem);
  }

  .hero .container {
    padding-block: var(--space-6);
  }

  .hero-stats {
    flex-direction: column;
    align-items: center;
  }

  .btn {
    white-space: normal;
  }

  .section,
  .section-sm {
    padding-block: var(--space-6);
  }

  .shop-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .shop-toolbar .result-count,
  .filter-mobile-btn,
  .sort-wrap {
    width: 100%;
  }

  .footer-bottom {
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-bottom>* {
    width: 100%;
  }

  .footer-newsletter input,
  .footer-newsletter button {
    width: 100%;
  }

  .cart-row {
    grid-template-columns: 70px 1fr;
    row-gap: var(--space-3);
  }

  .cart-row .cart-row-price {
    justify-self: start;
  }

  .cart-row .cart-row-price small {
    display: block;
    margin-top: 0.35rem;
  }

  .mobile-drawer {
    width: 100%;
    max-width: 100vw;
  }

  .product-card,
  .product-card img,
  .product-media,
  .product-media img {
    min-width: 0;
  }

  .order-table,
  .spec-table {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .auth-card {
    padding: var(--space-5);
  }
}

/* ============================================
   Theme Toggle Button (floating, works on every
   page regardless of header/footer JS include)
   ============================================ */
.theme-toggle {
  position: fixed;
  z-index: 999;
  right: var(--space-5);
  bottom: var(--space-5);
  width: 48px;
  height: 48px;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
  box-shadow: var(--shadow-md);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: var(--theme-transition), transform 0.2s ease;
  -webkit-tap-highlight-color: transparent;
}

.theme-toggle:hover {
  transform: translateY(-2px);
  border-color: var(--color-primary);
}

.theme-toggle:active {
  transform: translateY(0) scale(0.95);
}

.theme-toggle svg {
  width: 22px;
  height: 22px;
  stroke: currentColor;
  fill: none;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.theme-toggle .icon-moon { display: none; }
html[data-theme="dark"] .theme-toggle .icon-sun { display: none; }
html[data-theme="dark"] .theme-toggle .icon-moon { display: block; }

@media (max-width: 480px) {
  .theme-toggle {
    right: var(--space-4);
    bottom: var(--space-4);
    width: 42px;
    height: 42px;
  }

  .theme-toggle svg {
    width: 19px;
    height: 19px;
  }
}

/* ---------- Responsive: extreme small screens (down to ~200px) ---------- */
@media (max-width: 260px) {
  html, body {
    font-size: 12px;
  }

  .container {
    padding-inline: 0.35rem;
  }

  .hero h1 {
    font-size: 1.4rem;
  }

  .hero-stats {
    gap: 0.5rem;
  }

  .logo {
    font-size: 1rem;
  }

  .btn {
    padding: 0.5rem 0.6rem;
    font-size: 0.78rem;
  }

  .product-grid,
  .grid.products,
  .shop-grid,
  .products-grid,
  .cat-grid,
  .shop-products,
  .wishlist-grid,
  .team-grid,
  .footer-grid {
    grid-template-columns: 1fr !important;
  }

  .theme-toggle {
    width: 36px;
    height: 36px;
    right: var(--space-2);
    bottom: var(--space-2);
  }

  .theme-toggle svg {
    width: 16px;
    height: 16px;
  }

  /* Never allow anything to force a horizontal scrollbar at this width */
  img, svg, video, table, .order-table, .spec-table {
    max-width: 100%;
  }
}

/* Absolute floor: keep the layout intact even at the narrowest
   devices/embedded webviews (~200px) by guaranteeing no element can
   force overflow. */
html {
  overflow-x: hidden;
}

body {
  min-width: 200px;
  overflow-x: hidden;
}

/* ---------- Responsive: large desktop / QHD (1440px+) ---------- */
@media (min-width: 1440px) {
  :root {
    --container: 1320px;
  }
}

/* ---------- Responsive: ultra-wide / 4K (1920px+) ---------- */
@media (min-width: 1920px) {
  :root {
    --container: 1500px;
    --space-8: 4.5rem;
    --space-9: 7rem;
  }

  html, body {
    font-size: 17px;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 3.4vw, 4rem);
  }
}

/* ---------- Responsive: true 4K displays (2560px+) ---------- */
@media (min-width: 2560px) {
  :root {
    --container: 1800px;
  }

  html, body {
    font-size: 19px;
  }

  .hero h1 {
    font-size: clamp(3rem, 3vw, 4.6rem);
  }

  .product-media img,
  .hero-media img {
    max-height: 640px;
  }
}


/* ---------- Product Grid — Mobile (consolidated, single source of truth) ---------- */
@media (max-width: 600px) {
  .products-grid,
  .product-grid,
  .grid.products,
  .shop-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    padding-inline: 0;
  }

  .product-card {
    width: 100%;
    max-width: none;
    min-width: 0;
    border-radius: var(--radius-sm);
  }

  /* Keep image fit consistent with the desktop rule (object-fit: contain)
     so product photos aren't unexpectedly cropped on mobile. */
  .product-media {
    aspect-ratio: 1;
  }

  .product-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-2);
  }

  .product-card > img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .product-body {
    padding: var(--space-3);
    gap: var(--space-1);
  }

  .product-cat {
    font-size: 0.7rem;
  }

  .product-title {
    font-size: clamp(0.82rem, 3.4vw, 0.92rem);
    line-height: 1.35;
    /* Clamp to 2 lines so uneven title lengths don't misalign price/button rows across a row of cards */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .stars svg {
    width: 12px;
    height: 12px;
  }

  .stars .rating-count {
    font-size: 0.7rem;
  }

  .product-price {
    gap: var(--space-1);
  }

  .price-now {
    font-size: clamp(0.88rem, 3.6vw, 1rem);
  }

  .price-old {
    font-size: 0.78rem;
  }

  .product-body .btn {
    padding: 0.5rem 0.65rem;
    font-size: 0.76rem;
    gap: 0.35rem;
    margin-top: var(--space-2);
  }

  .product-body .btn svg {
    width: 14px;
    height: 14px;
  }

  .product-actions {
    /* On touch devices hover never fires, so keep actions reachable but small */
    opacity: 1;
    transform: none;
    top: var(--space-2);
    right: var(--space-2);
  }

  .product-actions button {
    width: 32px;
    height: 32px;
  }

  .product-actions svg {
    width: 14px;
    height: 14px;
  }
}


/* =========================================================
   MOBILE FIXES — FLASH SALE / PRODUCT BUTTONS / DARK NAV
   ========================================================= */

@media (max-width: 600px) {

  /* Flash-sale box: reduce the excessive inner padding on phones */
  .flash {
    padding: 0.85rem 0.6rem;
    border-radius: var(--radius);
  }

  .flash-head {
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }

  /* Keep flash-sale product content compact */
  .flash .product-body {
    padding: 0.55rem;
    gap: 0.2rem;
    margin-top: 20px;
  }

  .flash .product-title {
    font-size: 0.78rem;
    line-height: 1.25;
  }

  /* Smaller prices so OLD + NEW prices remain visible together */
  .flash .product-price {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    min-width: 0;
    flex-wrap: nowrap;
  }

  .flash .price-now {
    font-size: 0.82rem;
    line-height: 1.1;
    white-space: nowrap;
  }

  .flash .price-old {
    font-size: 0.68rem;
    line-height: 1.1;
    white-space: nowrap;
  }

  /* Add-to-cart button: make icon + text fit inside each mobile card */
  .flash .product-body .btn,
  .flash .product-body .js-add {
    width: 100%;
    min-width: 0;
    padding: 0.48rem 0.3rem;
    gap: 0.22rem;
    font-size: 0.66rem;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
  }

  .flash .product-body .btn svg,
  .flash .product-body .js-add svg {
    width: 111px;
    height: 12px;
    flex: 0 0 12px;
  }

  /* Mobile navigation/drawer must follow dark mode */
  html[data-theme="dark"] .mobile-drawer {
    background: var(--color-surface);
    color: var(--color-text);
    border-right: 1px solid var(--color-border);
  }

  html[data-theme="dark"] .mobile-drawer .nav-list a {
    color: var(--color-text);
    border-bottom-color: var(--color-border);
  }

  html[data-theme="dark"] .mobile-drawer .nav-list a:hover,
  html[data-theme="dark"] .mobile-drawer .nav-list a.active {
    color: var(--color-primary);
  }

  html[data-theme="dark"] .drawer-head {
    color: var(--color-text);
  }

  html[data-theme="dark"] .drawer-head button {
    color: var(--color-text);
  }

  html[data-theme="dark"] .drawer-overlay {
    background: rgba(0, 0, 0, 0.72);
  }
}

/* Extra-tight phones */
@media (max-width: 360px) {
  .flash {
    padding-inline: 0.45rem;
  }

  .flash .product-body {
    padding: 0.45rem;
  }

  .flash .product-title {
    font-size: 0.74rem;
  }

  .flash .price-now {
    font-size: 0.76rem;
  }

  .flash .price-old {
    font-size: 0.62rem;
  }

  .flash .product-body .btn,
  .flash .product-body .js-add {
    font-size: 0.61rem;
    padding-inline: 0.2rem;
  }

  .flash .product-body .btn svg,
  .flash .product-body .js-add svg {
    width: 11px;
    height: 11px;
    flex-basis: 11px;
  }
}


/* =========================================================
   FINAL OVERRIDES — MOBILE FLASH SALE + NAV DARK MODE
   ========================================================= */

@media (max-width: 600px) {

  /* ---------------------------------------------------------
     FLASH SALE
     Product cards/images touch the flash-sale box.
     The flash-sale heading keeps its own spacing.
     --------------------------------------------------------- */

  .flash .products-grid,
  .flash .product-grid,
  .flash .grid.products,
  .flash .shop-grid {
    width: calc(100% + 1.5rem) !important;
    margin-left: -0.75rem !important;
    margin-right: -0.75rem !important;
    padding: 0 !important;
    gap: 0 !important;
  }

  .flash .product-card {
    margin: 0 !important;
    padding: 0 !important;
    border-radius: 0 !important;
    width: 100% !important;
    min-width: 0 !important;
    box-shadow: none !important;
  }

  .flash .product-media {
    margin: 0 !important;
    padding: 0 !important;
    border-radius: 0 !important;
  }

  .flash .product-media img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    object-fit: contain !important;
  }

  .flash .product-body {
    margin: 0 !important;
    padding: 0.45rem !important;
  }

  .flash .product-title {
    font-size: 0.76rem !important;
    line-height: 1.2 !important;
  }

  .flash .product-price {
    display: flex !important;
    align-items: center !important;
    flex-wrap: nowrap !important;
    gap: 0.25rem !important;
    min-width: 0 !important;
    margin: 0 !important;
  }

  .flash .price-now {
    font-size: 0.78rem !important;
    white-space: nowrap !important;
  }

  .flash .price-old {
    font-size: 0.62rem !important;
    white-space: nowrap !important;
  }

  .flash .product-body .btn,
  .flash .product-body .js-add {
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    margin-top: 0.35rem !important;
    padding: 0.42rem 0.15rem !important;
    font-size: 0.62rem !important;
    line-height: 1 !important;
    gap: 0.18rem !important;
    white-space: nowrap !important;
    overflow: hidden !important;
  }

  .flash .product-body .btn svg,
  .flash .product-body .js-add svg {
    width: 11px !important;
    height: 11px !important;
    flex: 0 0 11px !important;
  }


  /* ---------------------------------------------------------
     MOBILE NAV / HEADER — DARK MODE
     --------------------------------------------------------- */

  html[data-theme="dark"] .header,
  html[data-theme="dark"] .header-main,
  html[data-theme="dark"] .nav,
  html[data-theme="dark"] .mobile-drawer {
    background: #191d23 !important;
    color: #e5e7eb !important;
    border-color: #2b303a !important;
  }

  html[data-theme="dark"] .mobile-drawer {
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.55) !important;
  }

  html[data-theme="dark"] .mobile-drawer .nav-list,
  html[data-theme="dark"] .mobile-drawer .nav-list > li {
    background: #191d23 !important;
  }

  html[data-theme="dark"] .mobile-drawer .nav-list a,
  html[data-theme="dark"] .mobile-drawer .nav-cats {
    background: transparent !important;
    color: #e5e7eb !important;
    border-color: #2b303a !important;
  }

  html[data-theme="dark"] .mobile-drawer .nav-list a:hover,
  html[data-theme="dark"] .mobile-drawer .nav-list a.active {
    background: #242932 !important;
    color: #ff8a3d !important;
  }

  html[data-theme="dark"] .mobile-drawer .drawer-head,
  html[data-theme="dark"] .mobile-drawer .drawer-head button,
  html[data-theme="dark"] .mobile-drawer svg {
    color: #e5e7eb !important;
  }

  html[data-theme="dark"] .drawer-overlay {
    background: rgba(0, 0, 0, 0.78) !important;
  }

  /* If the visible mobile navigation is the header/menu area */
  html[data-theme="dark"] .header *,
  html[data-theme="dark"] .header-main * {
    border-color: #2b303a;
  }

  html[data-theme="dark"] .header .logo,
  html[data-theme="dark"] .header .menu-toggle,
  html[data-theme="dark"] .header .icon-btn {
    color: #e5e7eb !important;
  }
}

@media (max-width: 360px) {
  .flash .products-grid,
  .flash .product-grid,
  .flash .grid.products,
  .flash .shop-grid {
    width: calc(100% + 0.9rem) !important;
    margin-left: -0.45rem !important;
    margin-right: -0.45rem !important;
  }

  .flash .product-body {
    padding: 0.35rem !important;
  }

  .flash .price-now {
    font-size: 0.73rem !important;
  }

  .flash .price-old {
    font-size: 0.58rem !important;
  }

  .flash .product-body .btn,
  .flash .product-body .js-add {
    font-size: 0.58rem !important;
    padding-inline: 0.1rem !important;
  }
}
